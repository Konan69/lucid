# Dependencies and generated output must come from the Linux build stages.
**/node_modules
**/dist
**/.cache
**/.turbo
**/coverage
**/*.tsbuildinfo
**/.expo
apps/mobile/android
apps/mobile/ios
apps/desktop/release
apps/desktop/out
# Windows helper binaries the desktop app ships (55 MB). No hosted image uses them, and with
# them a build context is over the deploy provider's 32 MB limit.
apps/desktop/vendor
**/build

# Local authority, credentials, research and mutable state never enter an image.
.git
.alchemy
.agents
.claude
.pi
**/.pi
**/.state
**/.env*
**/.npmrc
**/*.local
**/*.pem
**/*.key
artifacts
refs
docs/prds
CONTEXT.md
.vscode
.idea
