# Every part of the product is required. The stack stops before it starts anything, and the server
# and the runtime do not start, when one of these is missing or blank; the failure names the
# variable. `docs/19-infrastructure.md` ("Credentials and external services") says what each is.
# `.env.production` holds the production values of these names.

# PostgreSQL shared by the server, Flue runtime, and connector persistence.
DATABASE_URL=postgres://vivid:vivid@127.0.0.1:55433/vivid

# Server authentication. Generate a unique value with at least 32 characters,
# 12 distinct characters, and 3 character classes.
AUTH_SECRET=

# Server listener and public auth origin.
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787

# The Experiential Labs gateway key (xpl_…): memory, embeddings and decisions go through it.
EXPLABS_API_KEY=
# The OpenCode Go key (https://opencode.ai/docs/go/); Vivid's replies come through it.
OPENCODE_API_KEY=
OPENROUTER_API_KEY=

# Shared only by trusted application-server and runtime processes.
VIVID_RUNTIME_TOKEN=

# Optional model override.
VIVID_MODEL=opencode-go/glm-5.3-flash

# Vivid's Computer, on Boat. The key is a secret. The template is the name
# `infra/computer/prepare.py` printed.
VIVID_BOAT_API_KEY=
VIVID_BOAT_TEMPLATE=
# Optional: one existing machine for this environment's one Person, instead of a machine for each.
# Name a machine in ONE environment only. A machine records its holder on its own disk, so a second
# environment that names it is refused at the first wake.
# VIVID_BOAT_MACHINE=

# Memory. The hosted stack runs HelixDB and sets this itself; a server run by hand needs the
# absolute http(s) address of a HelixDB it can reach.
VIVID_HELIX_URL=

# Integrations, on Executor. The hosted stack sets the URL itself. The key and the organization are
# minted on that Executor.
VIVID_EXECUTOR_URL=
VIVID_EXECUTOR_KEY=
VIVID_EXECUTOR_ORGANIZATION=

# Texting, on Photon. Never give a local or test stack production's project: a second server
# reading the same project takes real Persons' texts.
VIVID_PHOTON_PROJECT_ID=
VIVID_PHOTON_PROJECT_SECRET=

# Notifications while away. Generate the pair once for an environment and keep it (the command is
# in docs/19-infrastructure.md); a new pair unsubscribes every browser and phone. The subject is an
# https: or mailto: contact.
VIVID_PUSH_VAPID_PUBLIC=
VIVID_PUSH_VAPID_PRIVATE=
VIVID_PUSH_SUBJECT=

# Sign-in with Google: the client's id and secret, and the address Google sends a Person back to.
# The same client signs a Person in to a Google Integration (Gmail, Calendar, Drive, Docs, Sheets,
# Tasks), so it must also allow <PUBLIC_URL>/api/connections/return.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback/google
