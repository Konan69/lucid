#!/usr/bin/env sh
set -eu

pnpm check:package-manager
pnpm check:versions
pnpm audit:effect-boundaries
pnpm check:migrations

lint_output="$(mktemp)"
trap 'rm -f "$lint_output"' EXIT

pnpm lint >"$lint_output" 2>&1 || {
  cat "$lint_output"
  exit 1
}
cat "$lint_output"

# Legacy warnings are ratcheted per rule. These values are ceilings, not
# allowances: lower a baseline whenever a change removes findings, and never
# increase one to make a push pass.
check_ratchet() {
  label="$1"
  plugin="$2"
  rule="$3"
  baseline="$4"
  count="$(grep -E -c "${plugin}(\\(|/)${rule}" "$lint_output" || true)"

  if [ "$count" -gt "$baseline" ]; then
    echo "$label warning ratchet failed: $count warnings exceed baseline $baseline"
    exit 1
  fi

  echo "$label warning ratchet passed: $count/$baseline"
}

check_ratchet "chained assertions" "anti-slop" "no-chained-type-assertions" 0
check_ratchet "conditional empty spreads" "anti-slop" "no-conditional-empty-object-spread" 0
check_ratchet "runtime typeof" "anti-slop" "no-runtime-typeof" 0
check_ratchet "shape names" "anti-slop" "no-shape-in-symbol-names" 0
check_ratchet "unknown parameters" "anti-slop" "no-unknown-parameters" 4
check_ratchet "unknown returns" "anti-slop" "no-unknown-returns" 0
check_ratchet "unsafe dictionaries" "anti-slop" "no-unsafe-dictionary-type" 0
check_ratchet "unjustified assertions" "anti-slop" "require-safety-comment-for-type-assertion" 0
check_ratchet "explicit any" "typescript" "no-explicit-any" 0
check_ratchet "async collection callbacks" "vivid" "no-async-callback-api" 0
check_ratchet "direct process env" "vivid" "no-direct-process-env" 6
check_ratchet "Effect service methods without Effect.fn" "vivid" "effect-require-effect-fn" 0
check_ratchet "global process runtime reads" "vivid" "no-global-process-runtime" 1
# Complexity ceilings match VCOS (classic complexity 12, 120-line functions, depth 3).
check_ratchet "cyclomatic complexity" "eslint" "complexity" 37
check_ratchet "long functions" "eslint" "max-lines-per-function" 28
check_ratchet "nested callbacks" "eslint" "max-nested-callbacks" 5
check_ratchet "wide parameter lists" "eslint" "max-params" 3
check_ratchet "deep nesting" "eslint" "max-depth" 2
check_ratchet "host transform validation" "vivid" "no-host-transform-validation" 2
check_ratchet "inline Schema compilers" "vivid" "no-inline-schema-compile" 1
check_ratchet "non-null assertions" "vivid" "no-non-null-assertion" 2
check_ratchet "optional chaining" "vivid" "no-optional-chaining" 4
check_ratchet "platform runtime terminals" "vivid" "no-platform-runtime-runmain-in-library" 0
check_ratchet "raw Promise constructors" "vivid" "no-promise-constructor" 0
check_ratchet "library runtime terminals" "vivid" "no-runpromise-in-library" 0
check_ratchet "Node built-in import namespaces" "vivid" "namespace-node-imports" 13
check_ratchet "try/catch" "vivid" "no-try-catch" 2
check_ratchet "undefined unions" "vivid" "no-undefined-in-union" 2
check_ratchet "unnamed Effect programs" "vivid" "require-named-effect-fn" 0
check_ratchet "Schema class titles" "vivid" "require-schema-class-title" 1
check_ratchet "unvalidated parsed JSON" "vivid" "require-schema-decode-in-boundary" 0
check_ratchet "derived state Effects" "vivid" "react-no-derived-state-effect" 0
check_ratchet "inline Context values" "vivid" "react-no-inline-context-value" 1
check_ratchet "design-system raw colors" "shadcn" "no-raw-colors" 2
check_ratchet "design-system arbitrary values" "shadcn" "no-arbitrary-values" 26
check_ratchet "design-system inline styles" "shadcn" "no-inline-styles" 22
check_ratchet "design-system unknown classes" "shadcn" "no-unknown-classes" 0
check_ratchet "Tailwind class conflicts" "tailwindcss" "no-conflicting-classes" 0
check_ratchet "Tailwind canonical syntax" "tailwindcss" "enforce-canonical" 0
check_ratchet "Tailwind class order" "tailwindcss" "enforce-sort-order" 0
check_ratchet "Tailwind shorthand" "tailwindcss" "enforce-shorthand" 0

pnpm format
pnpm typecheck
pnpm test:tooling
# Database suites skip unless VIVID_TEST_DATABASE_URL names a disposable database.
pnpm exec vitest run
