{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/.alchemy/**",
    "**/.alchemy.*/**",
    "**/.expo/**",
    "apps/mobile/vendor/**",
    "apps/web/vendor/**",
    "**/.output/**",
    "**/.turbo/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "apps/web/src/tree.gen.ts",
    "**/drizzle/**/snapshot.json",
    "**/product-drizzle/**/snapshot.json",
    "apps/cells/src/memory/migrations/**/snapshot.json",
    "apps/mobile/android/**",
    "apps/mobile/ios/**",
    "packages/design/tokens/src/native.ts",
    ".agents/**",
    "tools/oxlint/anti-slop/**",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock"
  ]
}
