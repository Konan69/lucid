{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true
  },
  "settings": {
    "shadcn": {
      "ui": "@/ui",
      "componentImports": ["(^|/)ui(/|$)"],
      "note": "Use Vivid's existing component variant or semantic token. Change a component contract only with UI-owner review."
    },
    "tailwindcss": {
      "entryPoint": [
        {
          "files": "apps/web/src/**",
          "use": "apps/web/src/styles/index.css"
        }
      ]
    }
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "apps/web/src/tree.gen.ts",
    "**/dist/**",
    "**/build/**",
    "**/.cache/**",
    "**/.output/**",
    "**/.turbo/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "scripts/__fixtures__/**",
    "scripts/oxlint-plugin-vivid.mjs",
    "apps/mobile/android/**",
    "apps/mobile/vendor/**",
    "apps/mobile/ios/**",
    "**/drizzle/**/snapshot.json"
  ],
  "jsPlugins": [
    {
      "name": "vivid",
      "specifier": "./scripts/oxlint-plugin-vivid.mjs"
    },
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "anti-slop-effect",
      "specifier": "./tools/oxlint/anti-slop/effect/index.ts"
    },
    "@shadcn/lint",
    "oxlint-tailwindcss"
  ],
  "rules": {
    "no-restricted-globals": [
      "error",
      {
        "name": "Option",
        "message": "Bare `Option` is the DOM <option> constructor. Import Option from effect/Option."
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "Effect",
        "property": "orDie",
        "message": "Keep typed Effect failures in the error channel until the owning runtime boundary."
      },
      {
        "object": "Effect",
        "property": "orDieWith",
        "message": "Keep typed Effect failures in the error channel until the owning runtime boundary."
      }
    ],
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^\\.\\.?/(?:.*?/)*(?:packages/)?(?:client-runtime|contracts)(?:/|$)",
            "message": "Import from @vivid/client-runtime or @vivid/contracts instead of crossing a package boundary with a relative path."
          }
        ]
      }
    ],
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "react/capitalized-calls": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/hooks": "off",
    "react/jsx-no-constructed-context-values": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": false }
    ],
    "unicorn/consistent-function-scoping": "off",
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-shape-in-symbol-names": "warn",
    "anti-slop/no-array-filter-map": "warn",
    "anti-slop/no-reduce-accumulator-copy": "warn",
    "anti-slop-effect/no-manual-effect-error-tag": "warn",
    "anti-slop-effect/no-manual-tag-comparison": "warn",
    "anti-slop-effect/no-manual-tagged-construction": "warn",
    "anti-slop-effect/prefer-effect-match": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-returns": "warn",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "warn",
    "anti-slop-effect/no-service-constructor-imports": "error",
    "vivid/effect-no-context-generic-service": "error",
    "vivid/effect-no-service-accessor": "error",
    "vivid/effect-no-service-inside-method": "error",
    "vivid/effect-no-service-object-syntax": "error",
    "vivid/effect-prefer-match-effect": "error",
    "vivid/effect-require-effect-fn": "warn",
    "vivid/no-async-callback-api": "warn",
    "vivid/no-config-provider-from-env-in-library": "error",
    "vivid/no-direct-process-env": "warn",
    "vivid/no-direct-schema-safeparse": "error",
    "vivid/no-effect-catch-raw-error": "error",
    "vivid/no-effect-option-constructors": "error",
    "vivid/no-effect-runtime-api": "error",
    "vivid/no-effect-wrapper-for-sync-callback-api": "error",
    "vivid/no-global-process-runtime": "warn",
    "vivid/no-host-transform-validation": "warn",
    "vivid/no-inline-schema-compile": "warn",
    "vivid/no-manual-effect-runtime-in-tests": "error",
    "vivid/no-non-null-assertion": "warn",
    "vivid/no-optional-chaining": "warn",
    "vivid/no-parse-method-alias": "error",
    "vivid/no-platform-runtime-runmain-in-library": "warn",
    "vivid/no-promise-constructor": "warn",
    "vivid/no-runpromise-in-library": "warn",
    "vivid/no-runpromise-nested": "error",
    "vivid/no-runtime-env-mutation": "error",
    "vivid/no-try-catch": "warn",
    "vivid/no-undefined-in-union": "warn",
    "vivid/no-unnecessary-die": "error",
    "vivid/prefer-state-match": "error",
    "vivid/namespace-node-imports": "warn",
    "vivid/require-named-effect-fn": "warn",
    "vivid/require-schema-class-identifier": "error",
    "vivid/require-schema-class-title": "warn",
    "vivid/require-schema-decode-in-boundary": "warn"
  },
  "overrides": [
    {
      "files": ["alchemy.run.ts"],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "apps/{server,web}/src/**/*.{ts,tsx}",
        "packages/*/src/**/*.{ts,tsx}",
        "packages/*/*/src/**/*.{ts,tsx}"
      ],
      "rules": {
        "typescript/no-explicit-any": "warn"
      }
    },
    {
      "files": ["apps/web/src/**/*.tsx"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": ["layout"],
            "contracts": [
              {
                "pattern": "^(Button|IconButton)$",
                "allow": ["layout"],
                "message": {
                  "spacing": "Use a {{component}} size: {{sizes|none defined}}.",
                  "default": "Use a {{component}} variant: {{variants|none defined}}."
                }
              },
              {
                "pattern": "^Card$",
                "allow": ["layout", "spacing"],
                "message": "Card owns surface, radius, and elevation; callers may control placement and content spacing."
              },
              {
                "pattern": "^(Avatar|PersonAvatar|Face|StatusLabel|StatusDot|ServiceMarks)$",
                "allow": ["layout"],
                "message": "This primitive owns its visual treatment; callers may control placement only."
              }
            ]
          }
        ],
        "shadcn/no-raw-colors": "warn",
        "shadcn/no-arbitrary-values": "warn",
        "shadcn/no-inline-styles": "warn",
        "shadcn/no-unknown-classes": "warn",
        "shadcn/require-static-classes": "error",
        "tailwindcss/no-duplicate-classes": "error",
        "tailwindcss/no-conflicting-classes": "warn",
        "tailwindcss/no-deprecated-classes": "error",
        "tailwindcss/no-unnecessary-whitespace": "error",
        "tailwindcss/no-dark-without-light": "error",
        "tailwindcss/no-contradicting-variants": "error",
        "tailwindcss/enforce-canonical": "warn",
        "tailwindcss/enforce-sort-order": "warn",
        "tailwindcss/enforce-shorthand": "warn",
        "tailwindcss/enforce-consistent-important-position": "error",
        "tailwindcss/enforce-negative-arbitrary-values": "error",
        "tailwindcss/enforce-consistent-variable-syntax": "error",
        "tailwindcss/consistent-variant-order": "error"
      }
    },
    {
      "files": ["apps/web/src/ui/**/*.{ts,tsx}"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": ["apps/{mobile,web}/**/*.{ts,tsx}"],
      "rules": {
        "vivid/react-no-derived-state-effect": "warn",
        "vivid/react-no-inline-context-value": "warn",
        "vivid/react-no-useless-memo": "error"
      }
    },
    {
      "files": ["apps/server/src/auth.ts"],
      "rules": {
        "vivid/better-auth-secure-options": "error"
      }
    },
    {
      "files": ["**/drizzle.config.ts"],
      "rules": {
        "vivid/require-drizzle-config-paths": "error"
      }
    },
    {
      "files": ["apps/mobile/**/*.{ts,tsx}"],
      "rules": {
        "anti-slop-effect/no-service-constructor-imports": "off",
        "no-restricted-properties": "off",
        "vivid/no-try-catch": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "**/*.spec.{ts,tsx}", "**/test/**", "**/tests/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-restricted-properties": "off",
        "vivid/no-direct-process-env": "off",
        "vivid/no-runtime-env-mutation": "off",
        "vivid/no-try-catch": "off"
      }
    },
    {
      "files": ["**/*.config.*", "scripts/**", "**/scripts/**"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "no-restricted-properties": "off",
        "vivid/no-direct-process-env": "off",
        "vivid/no-runtime-env-mutation": "off",
        "vivid/no-try-catch": "off"
      }
    },
    {
      "files": ["apps/web/src/ui/Marks.tsx"],
      "rules": {
        "shadcn/no-raw-colors": "off"
      }
    },
    {
      "files": [
        "apps/**/*.{ts,tsx,mjs}",
        "packages/**/*.{ts,tsx,mjs}",
        "infra/**/*.ts",
        "scripts/**/*.mjs",
        "alchemy.run.ts"
      ],
      "rules": {
        "complexity": [
          "warn",
          {
            "max": 12,
            "variant": "classic"
          }
        ],
        "max-lines-per-function": [
          "warn",
          {
            "max": 120,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-depth": ["warn", 3],
        "max-params": ["warn", 4],
        "max-nested-callbacks": ["warn", 3]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx,mjs}", "**/*.live.test.ts", "**/*.d.ts"],
      "rules": {
        "complexity": "off",
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off"
      }
    }
  ]
}
