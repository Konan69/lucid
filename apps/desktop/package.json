{
  "name": "@vivid/desktop",
  "productName": "Vivid",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Electron host for the Vivid web renderer: window chrome, deep links, and the desktop bridge.",
  "author": "Vivid",
  "license": "UNLICENSED",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build": "sh vendor/computer/fetch.sh && node ./scripts/build.mjs",
    "dev": "pnpm build && electron .",
    "start": "pnpm build && electron .",
    "typecheck": "node ../../scripts/types.mjs tsconfig.main.json tsconfig.preload.json",
    "lint": "node ../../scripts/lint.mjs",
    "test": "node ../../scripts/test.mjs",
    "package": "pnpm dist",
    "dist": "pnpm build && electron-builder"
  },
  "exports": {
    "./bridge": "./src/shared/bridge.ts",
    "./notice": "./src/shared/notice.ts"
  },
  "dependencies": {
    "@sentry/core": "catalog:",
    "@sentry/electron": "catalog:",
    "@vivid/client-runtime": "workspace:*",
    "@vivid/contracts": "workspace:*",
    "effect": "catalog:",
    "@vivid/state": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@vivid/agent-runtime": "workspace:*",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-builder-squirrel-windows": "catalog:",
    "esbuild": "catalog:",
    "vitest": "catalog:"
  }
}
