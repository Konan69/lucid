{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": ".cache/typescript/main.tsbuildinfo"
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts"]
}
