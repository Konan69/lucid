{
  "expo": {
    "name": "Vivid",
    "slug": "vivid",
    "scheme": "vivid",
    "version": "0.4.39",
    "runtimeVersion": "0.3.19",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "work.vivid.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "work.vivid.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vivid opens your photos so you can send pictures in a Thread.",
          "cameraPermission": "Vivid uses the camera so you can send a photo you take in a Thread.",
          "microphonePermission": "Vivid listens while you hold to talk."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Vivid shows your recent photos so you can send them in a Thread.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "vivid-7t",
          "project": "vivid-mobile",
          "disableAutoUpload": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vivid uses where you are for things near you, travel times and bookings, only when you share it.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Vivid listens while you hold to talk.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-quick-actions"
    ],
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "ffe4ecc2-76eb-43ec-be2d-d26bf33337bd"
      }
    },
    "owner": "konan69"
  }
}
