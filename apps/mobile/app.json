{
  "expo": {
    "name": "Vivid",
    "slug": "vivid",
    "scheme": "vivid",
    "version": "0.3.26",
    "runtimeVersion": "0.3.12",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "work.vivid.mobile"
    },
    "android": {
      "package": "work.vivid.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      [
        "@sentry/react-native/expo",
        {
          "organization": "vivid-7t",
          "project": "vivid-mobile",
          "disableAutoUpload": true
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png"
  }
}
