{
  "expo": {
    "name": "Vivid",
    "slug": "vivid",
    "scheme": "vivid",
    "version": "0.4.0",
    "runtimeVersion": "0.3.13",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "work.vivid.mobile"
    },
    "android": {
      "package": "work.vivid.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vivid opens your photos so you can send pictures in a Thread.",
          "cameraPermission": "Vivid uses the camera so you can send a photo you take in a Thread.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Vivid shows your recent photos so you can send them in a Thread.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "vivid-7t",
          "project": "vivid-mobile",
          "disableAutoUpload": true
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/icon.png"
  }
}
