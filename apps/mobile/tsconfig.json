{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "incremental": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": ".cache/typescript/tsconfig.tsbuildinfo",
    "types": ["react", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
