{
  "extends": ["../../tsconfig.base.json", "expo/tsconfig.base", "../../tsconfig.hermes.json"],
  "compilerOptions": {
    "strict": true,
    // Vendored sources and the OpenUI port share the web's unchecked-index and unused-local exceptions.
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "incremental": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": ".cache/typescript/tsconfig.tsbuildinfo",
    "types": ["react"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  // Vendor code ships on the phone and is typechecked here; oxlint ignores vendor copies.
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "vendor/**/*.ts", "vendor/**/*.tsx"],
  "references": [
    {
      "path": "../../packages/client/state/tsconfig.types.json"
    },
    {
      "path": "../../packages/client/rpc/tsconfig.types.json"
    },
    {
      "path": "../../packages/contracts/tsconfig.types.json"
    }
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    ".cache",
    ".turbo",
    "dist",
    "build",
    "coverage",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
