# The server does not start when a required setting is missing, blank or padded; the failure names
# the variable. There is no server that runs without one of the product's parts.

# Required. PostgreSQL URL with a postgres:// or postgresql:// scheme and a host.
DATABASE_URL=postgres://vivid:vivid@127.0.0.1:55433/vivid
# Required. At least 32 characters, 12 distinct characters, and 3 character classes.
AUTH_SECRET=Replace-with-32-plus-characters-and-symbols-123!
# Optional. Integer from 1 through 65535. Defaults to 8787.
PORT=8787
# Optional. Absolute URL used for auth origins. Defaults to http://localhost:3000.
PUBLIC_URL=http://127.0.0.1:8787
# Required. Where the Flue runtime listens, and the token the two share.
VIVID_RUNTIME_URL=http://127.0.0.1:5173
VIVID_RUNTIME_TOKEN=
# Required. The model gateway key: memory embeds through it and Threads are named through it.
EXPLABS_API_KEY=
# Required. Vivid's Computer on Boat: the key (a secret) and the prepared template's name.
VIVID_BOAT_API_KEY=
VIVID_BOAT_TEMPLATE=
# Optional. One existing machine for this server's one Person. Name it in one environment only.
# VIVID_BOAT_MACHINE=
# Required. Memory: the absolute http(s) address of HelixDB.
VIVID_HELIX_URL=
# Required. Integrations on Executor: its absolute URL, a key and the organization on it.
VIVID_EXECUTOR_URL=
VIVID_EXECUTOR_KEY=
VIVID_EXECUTOR_ORGANIZATION=
# Required. Texting on Photon. Never production's project on a local or test server.
VIVID_PHOTON_PROJECT_ID=
VIVID_PHOTON_PROJECT_SECRET=
# Required. Notifications while away: one key pair for this environment, and an https: or mailto: contact.
VIVID_PUSH_VAPID_PUBLIC=
VIVID_PUSH_VAPID_PRIVATE=
VIVID_PUSH_SUBJECT=
# Required. Sign-in with Google: client id, client secret, and an absolute return address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback/google
