{
  "name": "@vivid/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:product": "drizzle-kit generate --config product-drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:product": "drizzle-kit migrate --config product-drizzle.config.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@vivid/contracts": "workspace:*",
    "better-auth": "catalog:",
    "@alchemy.run/better-auth": "catalog:",
    "alchemy": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:",
    "croner": "^10.0.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@vivid/client-runtime": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:"
  }
}
