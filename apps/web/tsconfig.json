{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "types": ["vite/client"],
    "tsBuildInfoFile": ".cache/typescript/tsconfig.tsbuildinfo",
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/client/state/tsconfig.types.json"
    },
    {
      "path": "../../packages/client/rpc/tsconfig.types.json"
    },
    {
      "path": "../../packages/contracts/tsconfig.types.json"
    }
  ]
}
