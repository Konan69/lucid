{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["checkinputs", "@vivid/desktop#checkinputs", "@vivid/tokens#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/sentry-upload.mjs",
        "$TURBO_ROOT$/patches/**"
      ],
      "outputs": ["dist/**", "build/**", ".output/**", "!.output/cache/**"],
      "env": [
        "NODE_ENV",
        "BABEL_ENV",
        "VITE_*",
        "VIVID_COMMIT",
        "VIVID_SERVER_URL",
        "VIVID_SERVER",
        "EXPO_PUBLIC_*",
        "EXPO_NO_DOTENV",
        "SENTRY_*"
      ],
      "passThroughEnv": ["CI", "EXPO_NO_TELEMETRY"]
    }
  }
}
