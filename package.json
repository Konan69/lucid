{
  "name": "@vivid/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "prepare": "husky && effect-language-service patch && effect-tsgo patch --typescript",
    "dev": "pnpm infra:dev",
    "desktop": "pnpm --filter @vivid/desktop dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck typecheck:root --concurrency=1",
    "lint": "turbo run lint lint:root --concurrency=1",
    "lint:fix": "node scripts/lint.mjs --fix --workspace",
    "format": "turbo run format:root",
    "format:fix": "oxfmt .",
    "test": "node scripts/gate.mjs full --only test",
    "audit:effect-boundaries": "node scripts/effect-boundary-audit.mjs enforce",
    "audit:effect-boundaries:report": "node scripts/effect-boundary-audit.mjs report",
    "check:migrations": "node scripts/migrations.mjs check",
    "check:package-manager": "node scripts/package-manager.mjs",
    "check:versions": "node scripts/versions.mjs",
    "test:lint-rules": "node --test scripts/oxlint-plugin-vivid.test.mjs",
    "test:tooling": "node --test scripts/oxlint-plugin-vivid.test.mjs scripts/lint.test.mjs scripts/cache.test.mjs scripts/types.test.mjs scripts/gate.test.mjs scripts/release.test.mjs scripts/ceilings.test.mjs scripts/owners.test.mjs scripts/hermes.test.mjs scripts/build.test.mjs scripts/boundary.test.mjs scripts/references.test.mjs scripts/proof.test.mjs",
    "quality": "pnpm infra:verify && node scripts/gate.mjs full",
    "db:migrate": "node scripts/migrate.mjs",
    "infra:dev": "VIVID_DEPLOY_TARGET=local ALCHEMY_TELEMETRY_DISABLED=1 alchemy dev --stage local",
    "infra:verify": "node scripts/infra-verify.mjs",
    "infra:destroy": "VIVID_DEPLOY_TARGET=local ALCHEMY_TELEMETRY_DISABLED=1 alchemy destroy --stage local --yes",
    "infra:deploy": "VIVID_DEPLOY_TARGET=production ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --stage production --env-file .env.production",
    "structure": "konsistent",
    "typecheck:root": "node scripts/types.mjs tsconfig.json",
    "lint:root": "node scripts/lint.mjs",
    "format:root": "oxfmt --check .",
    "gate": "node scripts/gate.mjs"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@effect/language-service": "0.87.2",
    "@effect/tsgo": "0.51.0",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.83.0",
    "@sentry/cli": "3.8.0",
    "@shadcn/lint": "0.1.1",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "husky": "9.1.7",
    "konsistent": "catalog:",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tailwindcss": "1.12.0",
    "@maschwenk/tsrslint": "0.1.5",
    "tsc-rs": "0.8.0",
    "turbo": "2.11.2",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.0"
  }
}
