{
  "name": "@vivid/workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "12.4.2"
  },
  "scripts": {
    "prepare": "husky && effect-language-service patch",
    "dev": "pnpm infra:dev",
    "desktop": "pnpm --filter @vivid/desktop dev",
    "build": "turbo run build",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck --concurrency=1",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "turbo run test",
    "audit:effect-boundaries": "node scripts/effect-boundary-audit.mjs enforce",
    "audit:effect-boundaries:report": "node scripts/effect-boundary-audit.mjs report",
    "check:migrations": "node scripts/migrations.mjs check",
    "check:package-manager": "node scripts/package-manager.mjs",
    "check:versions": "node scripts/versions.mjs",
    "test:lint-rules": "node --test scripts/oxlint-plugin-vivid.test.mjs",
    "test:tooling": "node --test scripts/package-manager.test.mjs scripts/versions.test.mjs scripts/effect-boundary-audit.test.mjs scripts/migrations.test.mjs scripts/oxlint-plugin-vivid.test.mjs scripts/infra-verify.test.mjs",
    "quality": "pnpm check:package-manager && pnpm check:versions && pnpm audit:effect-boundaries && pnpm check:migrations && pnpm infra:verify && pnpm lint && pnpm format && pnpm typecheck && pnpm test:tooling && pnpm test",
    "db:migrate": "node scripts/migrate.mjs",
    "infra:dev": "VIVID_DEPLOY_TARGET=local ALCHEMY_TELEMETRY_DISABLED=1 alchemy dev --stage local",
    "infra:verify": "node scripts/infra-verify.mjs",
    "infra:destroy": "VIVID_DEPLOY_TARGET=local ALCHEMY_TELEMETRY_DISABLED=1 alchemy destroy --stage local --yes",
    "infra:deploy": "VIVID_DEPLOY_TARGET=production ALCHEMY_TELEMETRY_DISABLED=1 alchemy deploy --stage production",
    "structure": "konsistent"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.83.0",
    "@shadcn/lint": "0.1.1",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "husky": "9.1.7",
    "konsistent": "catalog:",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tailwindcss": "1.12.0",
    "oxlint-tsgolint": "7.0.2002",
    "turbo": "2.11.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
