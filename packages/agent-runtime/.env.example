# Required for the default OpenRouter model.
OPENROUTER_API_KEY=

# Shared only between the local web proxy and runtime. Generate a fresh value per environment.
KONAN_RUNTIME_TOKEN=

KONAN_MODEL=openrouter/z-ai/glm-5.3-flash
KONAN_RUNTIME_DB=.state/flue.sqlite

# Google OAuth2 credentials for connectors (Gmail, Calendar, Drive)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5178/api/connectors/google/callback

# Connector database
KONAN_CONNECTOR_DB=.state/connectors.sqlite
