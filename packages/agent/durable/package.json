{
  "name": "@vivid/durable",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/main.ts",
    "./core": "./src/core.ts",
    "./client": "./src/client.ts",
    "./postgres": "./src/postgres/main.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/main.d.ts",
        "default": "./dist/main.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./postgres": {
        "types": "./dist/postgres/main.d.ts",
        "default": "./dist/postgres/main.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "example": "node src/examples/serve.ts",
    "check:package": "node scripts/consumer.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "ai": "7.0.127",
    "effect": "4.0.0-rc.116",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.130",
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@effect/vitest": "catalog:",
    "@opentelemetry/api": "1.9.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "ai": "7.0.127",
    "effect": "catalog:",
    "jsdom": "30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "4.5.4",
    "@types/pg": "catalog:",
    "pg": "catalog:"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
