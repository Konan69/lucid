{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "rewriteRelativeImportExtensions": true,
    "tsBuildInfoFile": ".cache/typescript/build.tsbuildinfo"
  },
  "include": ["src/*.ts", "src/postgres/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/fixtures",
    "src/examples",
    "src/react",
    "src/conformance",
    "src/postgres/testing.ts"
  ]
}
