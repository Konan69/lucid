# The Experiential Labs gateway key (xpl_…); every model call goes through it.
EXPLABS_API_KEY=

# Shared only between the local web proxy and runtime. Generate a fresh value per environment.
VIVID_RUNTIME_TOKEN=

VIVID_MODEL=explabs/glm-5.3-flash

# PostgreSQL connection for Flue durable state and Vivid application tables.
DATABASE_URL=postgres://vivid:vivid@127.0.0.1:55433/vivid

# Google OAuth2 credentials for connectors (Gmail, Calendar, Drive)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5178/api/connectors/google/callback

# Google OAuth access and refresh tokens are stored in PostgreSQL. See the README TODO before
# using this in a production environment.
