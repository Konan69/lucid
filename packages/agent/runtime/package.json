{
  "name": "@vivid/agent-runtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cell": "./src/cell.ts",
    "./sandbox": "./src/tools/sandbox.ts",
    "./scope": "./src/tools/scope.ts",
    "./signins": "./src/tools/signins.ts",
    "./testing": "./tests/process.ts",
    "./tooltesting": "./src/tools/tests/harness.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check:types": "pnpm typecheck",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "import:flue": "tsx src/flue/main.ts",
    "test": "node ../../../scripts/test.mjs",
    "typecheck": "node ../../../scripts/types.mjs tsconfig.tests.json",
    "lint": "node ../../../scripts/lint.mjs",
    "types": "node ../../../scripts/types.mjs tsconfig.types.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@effect/platform-node": "catalog:",
    "@openuidev/lang-core": "catalog:",
    "@valibot/to-json-schema": "1.7.1",
    "@vivid/client-runtime": "workspace:*",
    "@vivid/contracts": "workspace:*",
    "@vivid/skills": "workspace:*",
    "agentfs-sdk": "0.6.4",
    "effect": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "valibot": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "vitest": "catalog:"
  }
}
