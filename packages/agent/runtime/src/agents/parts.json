          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["text", "number"]
          },
          "placeholder": {
            "type": "string"
          }
        },
        "required": ["value"],
        "additionalProperties": false,
        "description": "Text or number field; a number field stores numbers."
      },
      "TextArea": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          },
          "rows": {
            "type": "number"
          }
        },
        "required": ["value"],
        "additionalProperties": false
      },
      "Select": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": ["value", "label"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "label": {
            "type": "string"
          },
          "placeholder": {
            "type": "string"
          }
        },
        "required": ["value", "options"],
        "additionalProperties": false,
        "description": "Dropdown, for long option lists."
      },
      "SegmentedControl": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": ["value", "label"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "block": {
            "type": "boolean"
          }
        },
        "required": ["value", "options"],
        "additionalProperties": false,
        "description": "2 to 4 short choices in a row."
      },
      "Checkbox": {
        "type": "object",
        "properties": {
          "checked": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
