            "type": "boolean"
          }
        },
        "required": ["checked", "label"],
        "additionalProperties": false,
        "description": "lineThrough strikes the label when checked, for to-do lists."
      },
      "RadioGroup": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": ["value", "label"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "label": {
            "type": "string"
          },
          "variant": {
            "type": "string",
            "enum": ["list", "pills", "cards"]
          }
        },
        "required": ["value", "options"],
        "additionalProperties": false,
        "description": "pills for short choices; cards for choices that need a description line."
      },
      "Form": {
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": {}
          }
        },
        "required": ["children"],
        "additionalProperties": false,
        "description": "Groups fields; their values go with any @ToAssistant inside."
      }
    }
  }
}
