{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": ".cache/typescript/tsconfig.tsbuildinfo",
    "skipLibCheck": true
  },
  "include": ["src", "tests", "flue.config.ts"]
}
