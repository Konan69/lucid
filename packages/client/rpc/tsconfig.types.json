{
  "extends": ["../../../tsconfig.base.json", "../../../tsconfig.hermes.json"],
  "compilerOptions": {
    "noEmit": false,
    "tsBuildInfoFile": ".cache/typescript/types.tsbuildinfo",
    "composite": true,
