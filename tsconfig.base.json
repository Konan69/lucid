{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "effect/unstable/sql/SqlError": ["./node_modules/effect/dist/sql/SqlError.d.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "diagnosticsName": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectErrorsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectSuggestionsInTscExitCode": false,
        "missingDiagnosticNextLine": "error",
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "asyncFunction": "error",
          "newPromise": "error",
          "schemaSync": "error",
          "strictEffectProvide": "error"
        },
        "overrides": [
          {
            "include": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "schemaSync": "off"
              }
            }
          }
        ]
      }
    ]
  }
}
