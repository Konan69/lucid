{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/sentry-upload.mjs",
        "$TURBO_ROOT$/patches/**"
      ],
      "outputs": ["dist/**", "build/**", ".output/**", "!.output/cache/**"],
      "env": [
        "NODE_ENV",
        "BABEL_ENV",
        "VITE_*",
        "VIVID_COMMIT",
        "VIVID_SERVER_URL",
        "VIVID_SERVER",
        "EXPO_PUBLIC_*",
        "EXPO_NO_DOTENV",
        "SENTRY_*"
      ],
      "passThroughEnv": ["CI", "EXPO_NO_TELEMETRY"]
    },
    "typecheck": {
      "dependsOn": ["types", "^types", "checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.hermes.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/scripts/types.mjs"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": [".cache/typescript/**", "*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/apps/**/tsconfig*.json",
        "$TURBO_ROOT$/packages/**/tsconfig*.json",
        "$TURBO_ROOT$/scripts/lint.mjs",
        "$TURBO_ROOT$/scripts/oxlint-plugin-vivid.mjs",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/apps/web/src/styles/**"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC", "NODE_OPTIONS", "VIVID_LINT_THREADS"],
      "outputs": []
    },
    "checkinputs": {
      "dependsOn": ["^typeinputs"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!AGENTS.md"]
    },
    "typeinputs": {
      "dependsOn": ["^typeinputs"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!AGENTS.md"]
    },
    "//#lint:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/**",
        "packages/**",
        "tools/oxlint/**",
        "!**/{node_modules,.cache,.turbo,dist,build,coverage,.expo,.output,.alchemy,.alchemy.*,.state}/**",
        "!**/*.tsbuildinfo",
        "!**/.env*",
        "!**/*.local",
        "!apps/mobile/{android,ios}/**",
        "!docs/**",
        "!**/*.md"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC", "NODE_OPTIONS", "VIVID_LINT_THREADS"],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/**",
        "packages/**",
        "!**/{node_modules,.cache,.turbo,dist,build,coverage,.expo,.output,.alchemy,.alchemy.*,.state}/**",
        "!**/*.tsbuildinfo",
        "!**/.env*",
        "!**/*.local",
        "!apps/mobile/{android,ios}/**",
        "!docs/**",
        "!**/*.md"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": [".cache/typescript/root.tsbuildinfo"]
    },
    "//#format:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/**",
        "packages/**",
        "!**/{node_modules,.cache,.turbo,dist,build,coverage,.expo,.output,.alchemy,.alchemy.*,.state}/**",
        "!**/*.tsbuildinfo",
        "!**/.env*",
        "!**/*.local",
        "!apps/mobile/{android,ios}/**"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/test.mjs"
      ],
      "outputs": [".cache/gate/tests.json"],
      "env": [
        "VIVID_TEST_*",
        "VIVID_LIVE_*",
        "EXPLABS_API_KEY",
        "OPENCODE_API_KEY",
        "!VIVID_TEST_DATABASE_URL"
      ],
      "passThroughEnv": ["VIVID_TEST_DATABASE_URL", "VIVID_GATE_CACHE"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "interruptible": true
    },
    "types": {
      "dependsOn": ["^types", "typeinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tests/**",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.hermes.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/scripts/types.mjs"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": [".cache/typescript/types/**", ".cache/typescript/types.tsbuildinfo"]
    },
    "@vivid/contracts#typeinputs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tests/**"
      ]
    },
    "@vivid/client-runtime#typeinputs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tests/**"
      ]
    },
    "@vivid/state#typeinputs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tests/**"
      ]
    },
    "@vivid/skills#typeinputs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tests/**"
      ]
    },
    "@vivid/agent-runtime#typeinputs": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "!src/**/*.test.ts",
        "!src/**/*.test.tsx",
        "!tests/**"
      ]
    },
    "@vivid/skills#typecheck": {
      "dependsOn": [
        "types",
        "^types",
        "checkinputs",
        "@vivid/agent-runtime#types",
        "@vivid/agent-runtime#checkinputs"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.hermes.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/scripts/types.mjs"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": [".cache/typescript/**", "*.tsbuildinfo"]
    },
    "@vivid/skills#lint": {
      "dependsOn": ["checkinputs", "@vivid/agent-runtime#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/apps/**/tsconfig*.json",
        "$TURBO_ROOT$/packages/**/tsconfig*.json",
        "$TURBO_ROOT$/scripts/lint.mjs",
        "$TURBO_ROOT$/scripts/oxlint-plugin-vivid.mjs",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/apps/web/src/styles/**"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC", "NODE_OPTIONS", "VIVID_LINT_THREADS"],
      "outputs": []
    },
    "@vivid/agent-runtime#typecheck": {
      "dependsOn": ["types", "^types", "checkinputs", "@vivid/server#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.hermes.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/scripts/types.mjs"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": [".cache/typescript/**", "*.tsbuildinfo"]
    },
    "@vivid/agent-runtime#lint": {
      "dependsOn": ["checkinputs", "@vivid/server#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/apps/**/tsconfig*.json",
        "$TURBO_ROOT$/packages/**/tsconfig*.json",
        "$TURBO_ROOT$/scripts/lint.mjs",
        "$TURBO_ROOT$/scripts/oxlint-plugin-vivid.mjs",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/apps/web/src/styles/**"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC", "NODE_OPTIONS", "VIVID_LINT_THREADS"],
      "outputs": []
    },
    "@vivid/server#typecheck": {
      "dependsOn": [
        "types",
        "^types",
        "checkinputs",
        "@vivid/agent-runtime#types",
        "@vivid/agent-runtime#checkinputs"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.hermes.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/scripts/types.mjs"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": [".cache/typescript/**", "*.tsbuildinfo"]
    },
    "@vivid/server#lint": {
      "dependsOn": ["checkinputs", "@vivid/agent-runtime#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/apps/**/tsconfig*.json",
        "$TURBO_ROOT$/packages/**/tsconfig*.json",
        "$TURBO_ROOT$/scripts/lint.mjs",
        "$TURBO_ROOT$/scripts/oxlint-plugin-vivid.mjs",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/apps/web/src/styles/**"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC", "NODE_OPTIONS", "VIVID_LINT_THREADS"],
      "outputs": []
    },
    "@vivid/mobile#typecheck": {
      "dependsOn": ["types", "^types", "checkinputs", "@vivid/web#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/tsconfig.hermes.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/scripts/types.mjs"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": [".cache/typescript/**", "*.tsbuildinfo"]
    },
    "@vivid/mobile#lint": {
      "dependsOn": ["checkinputs", "@vivid/web#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/.oxlintrc.json",
        "$TURBO_ROOT$/tsconfig*.json",
        "$TURBO_ROOT$/hermes.d.ts",
        "$TURBO_ROOT$/apps/**/tsconfig*.json",
        "$TURBO_ROOT$/packages/**/tsconfig*.json",
        "$TURBO_ROOT$/scripts/lint.mjs",
        "$TURBO_ROOT$/scripts/oxlint-plugin-vivid.mjs",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/apps/web/src/styles/**"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC", "NODE_OPTIONS", "VIVID_LINT_THREADS"],
      "outputs": []
    },
    "@vivid/skills#test": {
      "dependsOn": ["checkinputs", "@vivid/agent-runtime#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/test.mjs"
      ],
      "outputs": [".cache/gate/tests.json"],
      "env": [
        "VIVID_TEST_*",
        "VIVID_LIVE_*",
        "EXPLABS_API_KEY",
        "OPENCODE_API_KEY",
        "!VIVID_TEST_DATABASE_URL"
      ],
      "passThroughEnv": ["VIVID_TEST_DATABASE_URL", "VIVID_GATE_CACHE"]
    },
    "@vivid/agent-runtime#test": {
      "dependsOn": ["checkinputs", "@vivid/server#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/test.mjs"
      ],
      "outputs": [".cache/gate/tests.json"],
      "env": [
        "VIVID_TEST_*",
        "VIVID_LIVE_*",
        "EXPLABS_API_KEY",
        "OPENCODE_API_KEY",
        "!VIVID_TEST_DATABASE_URL"
      ],
      "passThroughEnv": ["VIVID_TEST_DATABASE_URL", "VIVID_GATE_CACHE"]
    },
    "@vivid/server#test": {
      "dependsOn": ["checkinputs", "@vivid/agent-runtime#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/test.mjs"
      ],
      "outputs": [".cache/gate/tests.json"],
      "env": [
        "VIVID_TEST_*",
        "VIVID_LIVE_*",
        "EXPLABS_API_KEY",
        "OPENCODE_API_KEY",
        "!VIVID_TEST_DATABASE_URL"
      ],
      "passThroughEnv": ["VIVID_TEST_DATABASE_URL", "VIVID_GATE_CACHE"]
    },
    "@vivid/mobile#test": {
      "dependsOn": ["checkinputs", "@vivid/web#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/test.mjs"
      ],
      "outputs": [".cache/gate/tests.json"],
      "env": [
        "VIVID_TEST_*",
        "VIVID_LIVE_*",
        "EXPLABS_API_KEY",
        "OPENCODE_API_KEY",
        "!VIVID_TEST_DATABASE_URL"
      ],
      "passThroughEnv": ["VIVID_TEST_DATABASE_URL", "VIVID_GATE_CACHE"]
    },
    "//#test:tooling": {
      "inputs": [
        "*",
        ".oxlintrc.json",
        ".gitignore",
        "scripts/**",
        ".husky/**",
        ".github/**",
        "tools/**",
        "apps/**/package.json",
        "packages/**/package.json",
        "apps/**/tsconfig*.json",
        "packages/**/tsconfig*.json",
        "apps/*/drizzle/**",
        "apps/*/product-drizzle/**",
        "packages/**/drizzle/**",
        "!**/node_modules/**",
        "!*.md"
      ],
      "passThroughEnv": ["GOMAXPROCS", "GOMEMLIMIT", "GOGC"],
      "outputs": []
    },
    "@vivid/desktop#test": {
      "dependsOn": ["checkinputs", "@vivid/tokens#typeinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!AGENTS.md",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/test.mjs"
      ],
      "outputs": [".cache/gate/tests.json"],
      "env": [
        "VIVID_TEST_*",
        "VIVID_LIVE_*",
        "EXPLABS_API_KEY",
        "OPENCODE_API_KEY",
        "!VIVID_TEST_DATABASE_URL"
      ],
      "passThroughEnv": ["VIVID_TEST_DATABASE_URL", "VIVID_GATE_CACHE"]
    },
    "//#test:infra": {
      "inputs": [
        "*",
        "scripts/infra-verify.mjs",
        "scripts/infra-verify.test.mjs",
        ".github/workflows/**",
        "apps/web/wrangler.jsonc",
        "apps/server/src/**",
        "packages/agent/runtime/src/**",
        ".agents/skills/infra/**",
        "docs/19-infrastructure.md",
        "infra/**",
        "!**/node_modules/**",
        "!*.md"
      ],
      "outputs": []
    },
    "@vivid/agent-runtime#build": {
      "dependsOn": ["checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/sentry-upload.mjs",
        "$TURBO_ROOT$/patches/**"
      ],
      "outputs": ["dist/**", "build/**", ".output/**", "!.output/cache/**"],
      "env": [
        "NODE_ENV",
        "BABEL_ENV",
        "VITE_*",
        "VIVID_COMMIT",
        "VIVID_SERVER_URL",
        "VIVID_SERVER",
        "EXPO_PUBLIC_*",
        "EXPO_NO_DOTENV",
        "SENTRY_*",
        "!SENTRY_AUTH_TOKEN"
      ],
      "passThroughEnv": ["CI", "EXPO_NO_TELEMETRY"]
    },
    "build:updates": {
      "dependsOn": ["checkinputs", "@vivid/web#checkinputs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/sentry-upload.mjs",
        "$TURBO_ROOT$/patches/**"
      ],
      "outputs": [".cache/updates/**"],
      "env": [
        "NODE_ENV",
        "BABEL_ENV",
        "VITE_*",
        "VIVID_COMMIT",
        "VIVID_SERVER_URL",
        "VIVID_SERVER",
        "EXPO_PUBLIC_*",
        "EXPO_NO_DOTENV",
        "SENTRY_*",
        "!SENTRY_AUTH_TOKEN"
      ],
      "passThroughEnv": ["CI", "EXPO_NO_TELEMETRY"]
    }
  }
}
