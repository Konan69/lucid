{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".output/**", "!.output/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".cache/typescript/**", "*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VIVID_TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true,
      "interruptible": true
    }
  }
}
